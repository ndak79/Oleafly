* text=auto eol=lf

# Vendored upstream payloads are checksum-pinned against what upstream
# published. Any end-of-line translation changes their bytes and the pin fails
# on Windows checkouts only.
# Anchored patterns: a gitattributes pattern containing a slash matches from
# the repo root, so `resources/licenses/**` silently misses the real location
# under src-tauri/.
**/resources/licenses/** -text
patches/** -text
*.tar.gz binary
*.zip binary
*.patch -text

# Parsed with "\n"-based markers by scripts/fetch-language-servers.node-tests.mjs.
.github/workflows/*.yml text eol=lf
.github/*.yaml text eol=lf
.github/*.yml text eol=lf

# Zig formatting and workflow verification require stable LF bytes on Windows.
*.zig text eol=lf
*.zon text eol=lf
*.svg text eol=lf
native/zig/**/*.c text eol=lf
native/zig/**/*.h text eol=lf
native/zig/**/*.rc text eol=lf
native/zig/**/*.manifest text eol=lf
tools/zig/*.json text eol=lf
# Attestation JSONL is evidence, not source: preserve the exact upstream bytes
# (including the locked trusted-root line endings) across Windows checkouts.
tools/zig/attestations/*.jsonl binary
tools/zig/attestations/*.snappy binary
NOTICE text eol=lf
native/zig/THIRD_PARTY_NOTICES.txt text eol=lf
docs/**/*.md text eol=lf
*.md text eol=lf
